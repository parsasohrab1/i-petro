# Copy to .env for local runs. On GitHub Actions put these in repository Secrets instead.
ANTHROPIC_API_KEY=

# parsaint.group mailbox (cPanel) - drafts are saved here, never sent
IMAP_HOST=mail.parsaint.group
IMAP_PORT=993
IMAP_USER=info@parsaint.group
IMAP_PASSWORD=

# Daily notification - Telegram (recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: notification email to your own inbox
SMTP_HOST=mail.parsaint.group
SMTP_PORT=465
SMTP_USER=info@parsaint.group
SMTP_PASSWORD=
NOTIFY_EMAIL=

# Link shown in notifications (e.g. GitHub Pages URL)
DASHBOARD_URL=

# copy to .env and fill in
DOMAIN=ipetro.example.ir
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# folder holding fullchain.pem and privkey.pem
CERT_DIR=./certs
SESSION_DAYS=14
MAX_UPLOAD_MB=20
# set to 0 only while testing over plain http
COOKIE_SECURE=1
# page to serve: /app/platform/index.html (repo page, default) or /app/platform/ipetro-live.html (claude.ai v234 line)
PLATFORM_HTML=/app/platform/index.html
# optional Claude scoring of tasks and reports (needs a route to api.anthropic.com; a relay URL can go in BASE_URL)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
